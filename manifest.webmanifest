{
  "name": "QuizBowl - Quiz Manager",
  "short_name": "QuizBowl",
  "description": "Run quiz competitions: questions, teams, scoring and a live public display. Works offline.",
  "id": "./index.html",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0B1222",
  "theme_color": "#0B1222",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Public Display", "short_name": "Display", "url": "./public.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Add Question", "short_name": "Add", "url": "./index.html#add-question", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
